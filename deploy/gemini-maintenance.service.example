[Unit]
Description=vm2api Gemini maintenance broker
After=network.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=15
ExecStart=/usr/bin/python3 -I /usr/local/lib/vm2api-gemini-maintenance/scripts/gemini-maintenance.py --config /etc/vm2api/gemini-maintenance.json
RuntimeDirectory=vm2api-gemini-maintenance
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
