[Unit]
Description=vm2api Gemini host environments
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
RuntimeDirectory=vm2api-gemini
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=vm2api-gemini
StateDirectoryMode=0711
ExecStart=/usr/bin/python3 -I /usr/local/lib/vm2api-gemini/scripts/gemini-host.py --state /var/lib/vm2api-gemini --payload @INSTALL_DIR@/share/gemini/current @PAYLOAD_SOURCE_ARG@ --public-key /etc/vm2api/gemini-ed25519.pub @DEFAULT_PAYLOAD_ARGS@ --crag-host-dir @INSTALL_DIR@/data/crag-gemini-subscription/public --egress @INSTALL_DIR@/bin/kin-egress --socket /run/vm2api-gemini/control.sock --gateway-group vm2api --uid-base 29000
TimeoutStartSec=50
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
