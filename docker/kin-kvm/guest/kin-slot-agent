TMPFS_MAGIC = 0x01021994
MAX_LINE_BYTES = 2 * 1024 * 1024
MAX_CONTENT_BYTES = 1024 * 1024
MAX_LOCALTIME_BYTES = 64 * 1024
MAX_PUBLISH_FILES = 64

HEX64_RE = re.compile(r"^[0-9a-fA-F]{64}$")
SAFE_JSON_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\.json$")
SAFE_REL_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
SAFE_TZ_RE = re.compile(r"^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+){0,3}$")
RESERVED_PUBLISH_NAMES = frozenset({"sync-pending", "managed", "lock"})
FORBIDDEN_MANAGED_ENV_KEYS = frozenset({
