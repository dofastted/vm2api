    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
})
_FORBIDDEN_MANAGED_ENV_KEYS_LOWER = frozenset(k.lower() for k in FORBIDDEN_MANAGED_ENV_KEYS)

_LIBC = ctypes.CDLL(None, use_errno=True)


class _StatFS(ctypes.Structure):
    # On Linux (x86_64/aarch64), f_type is the leading signed long at offset 0.
    _fields_ = [("f_type", ctypes.c_long), ("_pad", ctypes.c_byte * 256)]


class RpcError(Exception):
    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code
        self.message = message


def fd_fs_magic(fd: int) -> int:
    st = _StatFS()
    rc = _LIBC.fstatfs(fd, ctypes.byref(st))
    if rc != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    return int(st.f_type)


def path_fs_magic(path: Path) -> int | None:
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        return fd_fs_magic(fd)
    except OSError:
        return None
    finally:
        os.close(fd)


def open_dir_nofollow(base_dir: Path, subparts: tuple[str, ...] = (), *, create_sub: bool = False, mode: int = 0o755) -> int:
    """Open base_dir (and optional immediate subparts) strictly rejecting any symlink."""
    try:
        st = os.lstat(str(base_dir))
    except FileNotFoundError as exc:
        raise RpcError("unsafe_path", f"base directory missing: {base_dir}") from exc
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise RpcError("unsafe_path", f"base path is not a real directory: {base_dir}")

    cur_fd = os.open(str(base_dir), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in subparts:
            if not part or part in (".", "..") or "/" in part or "\\" in part or "\x00" in part:
                raise RpcError("unsafe_path", f"invalid directory segment: {part!r}")
            try:
                next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=cur_fd)
            except FileNotFoundError:
                if not create_sub:
                    raise RpcError("unsafe_path", f"directory missing: {part}")
                os.mkdir(part, mode, dir_fd=cur_fd)
                next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=cur_fd)
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise RpcError("unsafe_path", f"symlink or non-directory encountered: {part}") from exc
                raise
            os.close(cur_fd)
            cur_fd = next_fd
        return cur_fd
    except Exception:
        os.close(cur_fd)
        raise


def atomic_write_in_dir(
    dir_fd: int,
    filename: str,
    content: bytes,
    *,
    mode: int,
    uid: int | None = None,
    gid: int | None = None,
) -> None:
    """Write content via same-directory temp file with O_NOFOLLOW, fsync, and os.replace."""
    if not filename or filename in (".", "..") or "/" in filename or "\\" in filename or "\x00" in filename:
        raise RpcError("unsafe_path", f"invalid filename: {filename!r}")
    try:
        prev = os.stat(filename, dir_fd=dir_fd, follow_symlinks=False)
        if stat.S_ISLNK(prev.st_mode) or not stat.S_ISREG(prev.st_mode) or prev.st_nlink != 1:
            raise RpcError("unsafe_path", f"destination is not a safe regular file: {filename}")
    except FileNotFoundError:
        pass

    tmp_name = f".kin-tmp-{uuid.uuid4().hex}"
    fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd)
    try:
        try:
            view = memoryview(content)
            written = 0
            while written < len(view):
                n = os.write(fd, view[written:])
                if n <= 0:
                    raise OSError("short write")
                written += n
            os.fsync(fd)
            os.fchmod(fd, mode)
            if os.geteuid() == 0 and uid is not None and gid is not None:
                os.fchown(fd, uid, gid)
        finally:
            os.close(fd)
        os.replace(tmp_name, filename, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)
    except Exception:
        try:
            os.unlink(tmp_name, dir_fd=dir_fd)
        except OSError:
            pass
        raise


def overwrite_in_place_no_trunc(
    dir_fd: int,
    filename: str,
    content: bytes,
    *,
    mode: int = 0o644,
) -> None:
    """Update a bind-mounted file's inode in place via pwrite + trailing ftruncate (no O_TRUNC race)."""
    if not filename or filename in (".", "..") or "/" in filename or "\\" in filename or "\x00" in filename:
        raise RpcError("unsafe_path", f"invalid filename: {filename!r}")
    try:
        prev = os.stat(filename, dir_fd=dir_fd, follow_symlinks=False)
        if stat.S_ISLNK(prev.st_mode) or not stat.S_ISREG(prev.st_mode) or prev.st_nlink != 1:
            raise RpcError("unsafe_path", f"destination is not a safe regular file: {filename}")
    except FileNotFoundError:
        pass

    fd = os.open(filename, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, mode, dir_fd=dir_fd)
    try:
        os.fchmod(fd, mode)
        if os.geteuid() == 0:
            os.fchown(fd, 0, 0)
        view = memoryview(content)
        written = 0
        while written < len(view):
            n = os.pwrite(fd, view[written:], written)
            if n <= 0:
                raise OSError("short pwrite")
            written += n
        os.ftruncate(fd, len(content))
        os.fsync(fd)
    finally:
        os.close(fd)


def validate_managed_preset_bytes(raw: bytes) -> dict[str, Any]:
    try:
        parsed = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RpcError("invalid_params", f"managed_preset must be valid UTF-8 JSON: {exc}") from exc
    if not isinstance(parsed, dict):
        raise RpcError("invalid_params", "managed_preset JSON must be an object")
    env_obj = parsed.get("env")
    if isinstance(env_obj, dict):
        bad = sorted(
            k
            for k in env_obj.keys()
            if isinstance(k, str) and k.lower() in _FORBIDDEN_MANAGED_ENV_KEYS_LOWER
        )
        if bad:
            raise RpcError("invalid_params", f"forbidden managed_preset env keys: {bad}")
    return parsed


def ensure_relative_symlink_in_dir(dir_fd: int, link_name: str, target_rel: str) -> None:
    """Atomically ensure link_name in dir_fd is a relative symlink pointing to target_rel."""
    if not link_name or "/" in link_name or "\\" in link_name or "\x00" in link_name:
        raise RpcError("unsafe_path", f"invalid symlink name: {link_name!r}")
    if not target_rel or "/" in target_rel or "\\" in target_rel or "\x00" in target_rel:
        raise RpcError("unsafe_path", f"invalid relative symlink target: {target_rel!r}")
    try:
        prev = os.stat(link_name, dir_fd=dir_fd, follow_symlinks=False)
        if stat.S_ISLNK(prev.st_mode):
            if os.readlink(link_name, dir_fd=dir_fd) == target_rel:
                return
        elif not stat.S_ISREG(prev.st_mode) or prev.st_nlink != 1:
            raise RpcError("unsafe_path", f"cannot replace unsafe path with symlink: {link_name}")
    except FileNotFoundError:
        pass

    tmp_link = f".kin-link-{uuid.uuid4().hex}"
    os.symlink(target_rel, tmp_link, dir_fd=dir_fd)
    try:
        os.replace(tmp_link, link_name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)
    except Exception:
        try:
            os.unlink(tmp_link, dir_fd=dir_fd)
        except OSError:
            pass
        raise


def decode_and_verify_payload(content_b64: Any, expected_sha256: Any) -> tuple[bytes, str]:
    if not isinstance(content_b64, str):
        raise RpcError("invalid_params", "content_b64 must be a string")
    if not isinstance(expected_sha256, str) or not HEX64_RE.fullmatch(expected_sha256):
        raise RpcError("invalid_params", "sha256 must be a 64-character hex string")
    if len(content_b64) > (MAX_CONTENT_BYTES * 4 // 3) + 64:
        raise RpcError("invalid_params", "content_b64 exceeds maximum allowed decoded size (1 MiB)")
    try:
        raw = base64.b64decode(content_b64.encode("ascii"), validate=True)
    except (ValueError, binascii.Error) as exc:
        raise RpcError("invalid_params", f"invalid base64 content: {exc}") from exc
    if len(raw) > MAX_CONTENT_BYTES:
        raise RpcError("invalid_params", f"decoded content exceeds 1 MiB ({len(raw)} bytes)")
    actual_sha256 = hashlib.sha256(raw).hexdigest()
    if not hmac.compare_digest(actual_sha256, expected_sha256.lower()):
        raise RpcError("sha256_mismatch", f"sha256 mismatch: expected {expected_sha256.lower()}, got {actual_sha256}")
    return raw, actual_sha256


def _mount_options_for(target: str) -> set[str] | None:
    found: set[str] | None = None
    try:
        with open("/proc/self/mountinfo", encoding="utf-8") as fh:
            for line in fh:
                fields = line.split()
                if len(fields) < 6:
                    continue
                mounted = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), fields[4])
                if mounted == target:
                    found = set(fields[5].split(","))
    except OSError:
        return None
    return found


def _mount_fstype_for(target: str) -> str | None:
    found: str | None = None
    try:
        with open("/proc/self/mountinfo", encoding="utf-8") as fh:
            for line in fh:
                parts = line.split(" - ", 1)
                if len(parts) != 2:
                    continue
                left = parts[0].split()
                right = parts[1].split()
                if len(left) < 5 or not right:
                    continue
                mounted = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), left[4])
                if mounted == target:
                    found = right[0]
    except OSError:
        return None
    return found


