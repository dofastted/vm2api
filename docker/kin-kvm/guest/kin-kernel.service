[Unit]
Description=kin-kernel gateway worker
After=kin-guest-setup.service
Requires=kin-guest-setup.service
# The kernel exits while its license or guest setup is still being delivered. With the default
# 5 starts / 10 s and RestartSec=2, that hits start-limit-hit in ~8 s and the unit stays failed,
# so a later license projection never brings the kernel back. Keep retrying every RestartSec.
StartLimitIntervalSec=0

[Service]
User=kincli
# Guest setup owns /run/kin-guest so kernel stops cannot remove slot.env.
EnvironmentFile=-/run/kin-guest/slot.env
Environment=HOME=/home/kincli
Environment=CLAUDE_CONFIG_DIR=/home/kincli/.claude
Environment=KIN_SUBMIT_WAIT_MS=30000
ExecStart=/usr/local/sbin/kin-kernel-start
Restart=always
RestartSec=2
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
