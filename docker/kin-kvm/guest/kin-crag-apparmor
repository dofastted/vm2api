#!/usr/bin/env python3
"""Prepare the KVM kernel's AppArmor userns exception before a launch."""

import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile


MARKER = '# Managed by vm2api kin-crag-apparmor.'
PROFILE_NAME = 'vm2api-crag'
PROFILE = (MARKER + '\n'
           'abi <abi/4.0>,\n'
           'profile ' + PROFILE_NAME + ' flags=(unconfined) {\n'
           '  userns,\n'
           '}\n').encode()
DROPIN = (MARKER + '\n'
          '[Unit]\n'
          'After=apparmor.service\n'
          'Requires=apparmor.service\n'
          '\n'
          '[Service]\n'
          'AppArmorProfile=' + PROFILE_NAME + '\n').encode()
RESTART = ['systemctl', 'restart', 'kin-kernel.service']
# Guest images built before v1.4.133 declare RuntimeDirectory=kin-guest in kin-kernel.service, so every kernel stop
# removed /run/kin-guest/slot.env and the CRAG license projection then waited for guest setup forever. Only new images
# carry the fixed unit; this helper is inlined on every start, so it neutralises the old declaration in place.
RUNTIME_DROPIN_PATH = '/etc/systemd/system/kin-kernel.service.d/40-vm2api-guest-runtime.conf'
RUNTIME_DROPIN = (MARKER + '\n'
                  '# kin-guest-setup owns /run/kin-guest; kernel stops must not remove slot.env.\n'
                  '[Service]\n'
                  'RuntimeDirectory=\n').encode()
SLOT_ENV = '/run/kin-guest/slot.env'
# CRAG v2 appends each session's tap.jsonl under /run/kin/work while the CLI keeps stat()ing it. /run/kin is the
# host 9p share; on guest kernels whose v9fs getattr starts writeback of dirty pages (filemap_fdatawrite), a stat
# that lands mid-writeback can wait on that folio forever. The CLI threads then sit in D state, the process never
# finishes exiting and CRAG keeps the session slot busy, so every later request on the slot hangs until the
# gateway times out. Keep the work directory on guest tmpfs so the hot tap files never go through 9p. "-+" runs the
# mount as root and never blocks the kernel: if it fails, the kernel starts on the 9p directory as before.
WORK_DROPIN_PATH = '/etc/systemd/system/kin-kernel.service.d/45-vm2api-crag-work.conf'
WORK_DROPIN = (MARKER + '\n'
               '# CRAG tap files stay on guest tmpfs: stat during 9p writeback can wedge a session.\n'
               '[Service]\n'
               "ExecStartPre=-+/bin/sh -c '[ ! -L /run/kin/work ] && { mountpoint -q /run/kin/work || "
               "{ mkdir -p /run/kin/work && [ ! -L /run/kin/work ] && "
               "mount -t tmpfs -o mode=0700,uid=$(id -u kincli),gid=$(id -g kincli),size=256m,nosuid,nodev "
               "vm2api-crag-work /run/kin/work; }; }'\n").encode()
# ~/.claude/.claude.json atomic saves (temp siblings + fchmod) still go through the kinhome/kinclaude 9p mounts; kin-guest-setup
# uses cache=none there (#1877) only after the on-disk script is updated from cidata and the guest reboots — restarting
# kin-guest-setup.service here (slot.env restore below) does not remount 9p or change cache=. The work directory is not the only other hot file on 9p. CRAG starts the CLI in /run/kin/work with --resume, so every
# request also writes a resume transcript under ~/.claude/projects/-run-kin-work/ and the CLI appends to and stat()s
# it for the whole turn. ~ is the kinhome 9p share, so the same writeback wait still wedged sessions on a guest that
# already had the work directory on tmpfs (zombie CLI, threads in folio_wait_bit_common). The transcripts only serve the
# request that wrote them (CRAG >= 3.1.20 reclaims leftovers, #1726), so they move to guest tmpfs as well; a guest
# reboot drops them. Paths stay literal (systemd expands ${NAME} in the command line); ~/.claude is created as kincli
# only when missing, so a mount failure leaves the CLI on a writable 9p directory as before.
TRANSCRIPT_DIR = '/home/kincli/.claude/projects'
TRANSCRIPT_DROPIN_PATH = '/etc/systemd/system/kin-kernel.service.d/46-vm2api-crag-transcripts.conf'
TRANSCRIPT_DROPIN = (MARKER + '\n'
                     '# CRAG resume transcripts stay on guest tmpfs: the same 9p writeback wait as the tap files.\n'
                     '[Service]\n'
                     "ExecStartPre=-+/bin/sh -c '[ ! -L /home/kincli/.claude ] && [ ! -L " + TRANSCRIPT_DIR + " ] && "
                     "{ mountpoint -q " + TRANSCRIPT_DIR + " || { "
                     "{ [ -d /home/kincli/.claude ] || install -d -m 0700 -o kincli -g kincli /home/kincli/.claude; } && "
                     "{ [ -d " + TRANSCRIPT_DIR + " ] || install -d -m 0700 -o kincli -g kincli " + TRANSCRIPT_DIR + "; } && "
                     "[ ! -L /home/kincli/.claude ] && [ ! -L " + TRANSCRIPT_DIR + " ] && "
                     "mount -t tmpfs -o mode=0700,uid=$(id -u kincli),gid=$(id -g kincli),size=512m,nosuid,nodev "
                     "vm2api-crag-transcripts " + TRANSCRIPT_DIR + "; }; }'\n").encode()


# Guest disks created before #1924 keep the first-boot copy of kin-guest-setup, which mounts kinhome/kinclaude with
# cache=mmap; cloud-init never reinstalls it, so the cache=none fix only reached new overlays and existing CRAG slots
# kept collecting zombie claude processes wedged in v9fs getattr writeback. This helper runs before every kernel
# start, so it upgrades exactly those two mount lines in place. The running mounts keep their options until the guest
# boots again (slot stop/start, 恢复服务); kin-guest-setup then mounts them with cache=none.
GUEST_SETUP_PATH = '/usr/local/sbin/kin-guest-setup'
GUEST_SETUP_9P = (
    (b'mount_9p kinhome /home/kincli mmap\n', b'mount_9p kinhome /home/kincli none\n'),
    (b'mount_9p kinclaude /home/kincli/.claude mmap\n', b'mount_9p kinclaude /home/kincli/.claude none\n'),
)


def result(status, reason, profile=PROFILE_NAME):
    return {'ok': True, 'status': status, 'reason': reason, 'profile': profile}


def fixed_path(root, name):
    path = root / name.lstrip('/')
    resolved = path.resolve()
    if resolved != root and root not in resolved.parents:
        raise RuntimeError('configured root contains an escaping symlink')
    return path


def read_optional(path):
    try:
        return path.read_text().strip()
    except FileNotFoundError:
        return None


def snapshot(path):
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(metadata.st_mode):
        raise RuntimeError('managed path is not a regular file: ' + str(path))
    data = path.read_bytes()
    if not data.splitlines() or data.splitlines()[0] != MARKER.encode():
        raise RuntimeError('refusing to overwrite an operator-managed file: ' + str(path))
    return data, stat.S_IMODE(metadata.st_mode)


def atomic_write(path, data, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'wb') as output:
            os.fchmod(output.fileno(), mode)
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def restore(path, previous):
    if previous is None:
        path.unlink(missing_ok=True)
    else:
        atomic_write(path, previous[0], previous[1])


def run(argv, action):
    completed = subprocess.run(argv, text=True, capture_output=True, timeout=30)
    if completed.returncode:
        detail = completed.stderr.strip()[:500]
        raise RuntimeError(action + ' failed (' + str(completed.returncode) + ')' + (': ' + detail if detail else ''))
    return completed.stdout.strip()


def command(name):
    executable = shutil.which(name)
    if executable is None:
        raise RuntimeError(name + ' is required for the AppArmor userns exception')
    return executable


def declares_runtime_directory(unit):
    text = read_optional(unit)
    return bool(text) and any(re.match(r'\s*RuntimeDirectory\s*=\s*\S', line) for line in text.splitlines())


def preserve_guest_runtime(root):
    """Keep slot.env across kernel stops on old guest units and restore it if a stop already removed it."""
    unit = fixed_path(root, '/etc/systemd/system/kin-kernel.service')
    state = {'guest_runtime': 'not-needed'}
    if declares_runtime_directory(unit):
        dropin = fixed_path(root, RUNTIME_DROPIN_PATH)
        previous = snapshot(dropin)
        if previous is not None and previous[0] == RUNTIME_DROPIN:
            state['guest_runtime'] = 'already-preserved'
        else:
            systemctl = command('systemctl')
            atomic_write(dropin, RUNTIME_DROPIN)
            try:
                run([systemctl, 'daemon-reload'], 'systemd reload')
            except Exception as error:
                try:
                    restore(dropin, previous)
                    run([systemctl, 'daemon-reload'], 'systemd rollback reload')
                except Exception as rollback_error:
                    raise RuntimeError(str(error) + '; rollback: ' + str(rollback_error)) from error
                raise
            state['guest_runtime'] = 'preserved'
    slot_env = fixed_path(root, SLOT_ENV)
    if os.path.lexists(slot_env):
        state['guest_setup'] = 'present'
        return state
    systemctl = command('systemctl')
    setup = run([systemctl, 'show', 'kin-guest-setup.service', '--property=ActiveState', '--value'],
                'guest setup inspection')
    if setup != 'active':
        # First boot: setup has not finished yet and writes slot.env itself.
        state['guest_setup'] = 'pending'
        return state
    # Restores slot.env only; does not refresh 9p cache= (see kin-guest-setup mount_9p).
    run([systemctl, 'restart', 'kin-guest-setup.service'], 'guest setup restore')
    if not slot_env.is_file():
        raise RuntimeError('kin-guest-setup did not restore ' + SLOT_ENV)
    state['guest_setup'] = 'restored'
    return state


def reload_or_restore(systemctl, path, previous):
    try:
        run([systemctl, 'daemon-reload'], 'systemd reload')
    except Exception as error:
        try:
            restore(path, previous)
            run([systemctl, 'daemon-reload'], 'systemd rollback reload')
        except Exception as rollback_error:
            raise RuntimeError(str(error) + '; rollback: ' + str(rollback_error)) from error
        raise


def isolate_tmpfs(root, path, content, key):
    """Install a managed drop-in that mounts guest tmpfs before every kernel start (see WORK/TRANSCRIPT_DROPIN)."""
    dropin = fixed_path(root, path)
    try:
        previous = snapshot(dropin)
    except RuntimeError:
        return {key: 'operator-managed'}
    if previous is not None and previous[0] == content:
        return {key: 'already-tmpfs'}
    systemctl = command('systemctl')
    atomic_write(dropin, content)
    reload_or_restore(systemctl, dropin, previous)
    return {key: 'tmpfs'}


def release_tmpfs(root, path, key):
    """Leaving CRAG v2: drop a managed mount hook. An existing tmpfs stays until the guest reboots."""
    dropin = fixed_path(root, path)
    try:
        previous = snapshot(dropin)
    except RuntimeError:
        return {key: 'operator-managed'}
    if previous is None:
        return {key: 'not-crag-v2'}
    systemctl = command('systemctl')
    dropin.unlink()
    reload_or_restore(systemctl, dropin, previous)
    return {key: 'released'}


def isolate_work_dir(root):
    return isolate_tmpfs(root, WORK_DROPIN_PATH, WORK_DROPIN, 'work_dir')


def release_work_dir(root):
    return release_tmpfs(root, WORK_DROPIN_PATH, 'work_dir')


def isolate_transcripts(root):
    return isolate_tmpfs(root, TRANSCRIPT_DROPIN_PATH, TRANSCRIPT_DROPIN, 'transcripts')


def release_transcripts(root):
    return release_tmpfs(root, TRANSCRIPT_DROPIN_PATH, 'transcripts')


def remove_binding(dropin):
    previous = snapshot(dropin)
    if previous is None:
        return result('skipped', 'not-crag-v2')
    systemctl = command('systemctl')
    dropin.unlink()
    try:
        run([systemctl, 'daemon-reload'], 'systemd reload')
    except Exception:
        restore(dropin, previous)
        run([systemctl, 'daemon-reload'], 'systemd rollback reload')
        raise
    # A still-running CRAG process may use this profile until the caller restarts it.
    return result('removed', 'not-crag-v2')


def upgrade_guest_9p_cache(root):
    """Rewrite the old cache=mmap mount lines of an existing guest's kin-guest-setup (takes effect at next boot)."""
    path = fixed_path(root, GUEST_SETUP_PATH)
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        return {'guest_9p_cache': 'no-guest-setup'}
    if not stat.S_ISREG(metadata.st_mode):
        return {'guest_9p_cache': 'operator-managed'}
    data = path.read_bytes()
    upgraded = data
    for old, new in GUEST_SETUP_9P:
        if upgraded.count(old) > 1:
            return {'guest_9p_cache': 'operator-managed'}
        upgraded = upgraded.replace(old, new)
    if upgraded == data:
        return {'guest_9p_cache': 'current'}
    atomic_write(path, upgraded, stat.S_IMODE(metadata.st_mode))
    return {'guest_9p_cache': 'upgraded-next-boot'}


def prepare(root):
    config_path = fixed_path(root, '/run/kin/kernel.json')
    dropin = fixed_path(root, '/etc/systemd/system/kin-kernel.service.d/50-vm2api-crag-userns.conf')
    try:
        config = json.loads(config_path.read_text())
    except FileNotFoundError:
        return result('skipped', 'kernel-config-missing')
    except (ValueError, UnicodeError):
        raise RuntimeError('invalid kernel configuration JSON') from None
    if not isinstance(config, dict):
        raise RuntimeError('kernel configuration must be an object')
    cache = upgrade_guest_9p_cache(root)
    if config.get('dataplane') != 'crag' or config.get('crag_kernel_version') != 'v2':
        return {**remove_binding(dropin), **release_work_dir(root), **release_transcripts(root), **cache}
    guest = preserve_guest_runtime(root)
    profile = bind_profile(root, dropin)
    return {**profile, **guest, **isolate_work_dir(root), **isolate_transcripts(root), **cache}


def bind_profile(root, dropin):
    enabled = read_optional(fixed_path(root, '/sys/module/apparmor/parameters/enabled'))
    if enabled not in ('Y', '1', 'yes'):
        return result('skipped', 'apparmor-disabled')
    restricted = read_optional(fixed_path(root, '/proc/sys/kernel/apparmor_restrict_unprivileged_userns'))
    if restricted != '1':
        return result('skipped', 'userns-not-restricted')

    systemctl = command('systemctl')
    current = run([systemctl, 'show', 'kin-kernel.service', '--property=AppArmorProfile', '--value'],
                  'kernel AppArmor profile inspection')
    if current and current != PROFILE_NAME:
        return result('skipped', 'operator-managed', current)
    profile = fixed_path(root, '/etc/apparmor.d/vm2api-crag')
    previous_profile = snapshot(profile)
    if current == PROFILE_NAME and previous_profile is None:
        return result('skipped', 'operator-managed', current)
    parser = command('apparmor_parser')
    if not fixed_path(root, '/etc/apparmor.d/abi/4.0').is_file():
        raise RuntimeError('AppArmor ABI 4.0 is required while unprivileged userns are restricted')
    service = run([systemctl, 'show', 'apparmor.service', '--property=LoadState', '--value'],
                  'AppArmor boot service inspection')
    if service != 'loaded':
        raise RuntimeError('apparmor.service is required to load the profile at guest boot')

    previous_dropin = snapshot(dropin)
    profile_changed = previous_profile is None or previous_profile[0] != PROFILE
    dropin_changed = previous_dropin is None or previous_dropin[0] != DROPIN
    profile_written = False
    dropin_written = False
    profile.parent.mkdir(parents=True, exist_ok=True)
    descriptor, candidate = tempfile.mkstemp(prefix='.vm2api-crag-check.', dir=profile.parent)
    try:
        with os.fdopen(descriptor, 'wb') as output:
            output.write(PROFILE)
        run([parser, '-Q', '-K', candidate], 'AppArmor policy check')
        if profile_changed:
            atomic_write(profile, PROFILE)
            profile_written = True
        run([parser, '-r', '-K', str(profile)], 'AppArmor policy load')
        if dropin_changed:
            atomic_write(dropin, DROPIN)
            dropin_written = True
        if dropin_changed:
            run([systemctl, 'daemon-reload'], 'systemd reload')
    except Exception as error:
        rollback_errors = []
        for path, previous, written in ((dropin, previous_dropin, dropin_written),
                                        (profile, previous_profile, profile_written)):
            if written:
                try:
                    restore(path, previous)
                except Exception as rollback_error:
                    rollback_errors.append(str(rollback_error))
        if profile_written and previous_profile is not None:
            try:
                run([parser, '-r', '-K', str(profile)], 'AppArmor rollback load')
            except Exception as rollback_error:
                rollback_errors.append(str(rollback_error))
        if dropin_written:
            try:
                run([systemctl, 'daemon-reload'], 'systemd rollback reload')
            except Exception as rollback_error:
                rollback_errors.append(str(rollback_error))
        # Keep a newly loaded, unattached profile: unloading may unconfine live tasks.
        if rollback_errors:
            raise RuntimeError(str(error) + '; rollback: ' + '; '.join(rollback_errors)) from error
        raise
    finally:
        os.unlink(candidate)
    return result('prepared', 'updated' if profile_changed or dropin_changed else 'already-configured')


def main():
    arguments = sys.argv[1:]
    if arguments[:1] == ['--']:
        arguments = arguments[1:]
    if arguments and arguments != RESTART:
        raise RuntimeError('only systemctl restart kin-kernel.service may follow preparation')
    if getattr(os, 'geteuid', lambda: -1)() != 0:
        raise RuntimeError('AppArmor preparation requires root')
    raw_root = os.environ.get('KIN_CRAG_APPARMOR_ROOT', '/')
    root = Path(raw_root)
    if not root.is_absolute() or not root.is_dir():
        raise RuntimeError('KIN_CRAG_APPARMOR_ROOT must be an existing absolute directory')
    root = root.resolve()
    print(json.dumps(prepare(root)), flush=True)
    if arguments:
        os.execvp(arguments[0], arguments)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(json.dumps({'ok': False, 'error': str(error)}), file=sys.stderr, flush=True)
        raise SystemExit(1)
