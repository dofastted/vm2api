# copy to .env  (chmod 600). Used by docker compose and local node.
# VM2API_* wins; KIN_* is fallback.
#
# 未配置时一键脚本 / 容器入口会只填空字段：
#   管理台 admin / 123456（已有密码不覆盖）
#   VM2API_API_KEY / VM2API_DB_SECRET / POSTGRES_PASSWORD / REDIS_PASSWORD 为空则生成随机 hex

VM2API_API_KEY=
VM2API_ADMIN_USER=admin
VM2API_ADMIN_PASSWORD=123456
VM2API_DB_SECRET=

PORT=8787
HOST=0.0.0.0
# HOST 仅监听；/health、/v1/meta 的 base_url 需配置 PUBLIC_BASE_URL 或 PUBLIC_HOST（勿把 0.0.0.0 当对外地址）
# PUBLIC_BASE_URL=https://example.com
# PUBLIC_HOST=127.0.0.1
# GITHUB_TOKEN=          # 可选。面板查 GitHub Release 提高限额；也可用 VM2API_GITHUB_TOKEN

# ==============================================================================
# PostgreSQL 数据库配置（生产默认，参考 sub2api 成熟结构）
# ==============================================================================
# 驱动选择：auto（有 PG 配置时走 postgres，否则 sqlite）| postgres | sqlite
VM2API_DB_DRIVER=postgres

# 本地 Docker PostgreSQL（仅监听 127.0.0.1，不暴露公网）
POSTGRES_USER=vm2api
POSTGRES_PASSWORD=
POSTGRES_DB=vm2api
VM2API_PG_PORT=5432

# 若使用外部/云端 PostgreSQL（如 Supabase / RDS / Neon / 自建高可用 PG），直接配置 DATABASE_URL 即可：
# DATABASE_URL=postgresql://user:password@pg.example.com:5432/vm2api?sslmode=require
# DATABASE_SSLMODE=disable
# VM2API_DB_MAX_OPEN_CONNS=25
# VM2API_DB_IDLE_TIMEOUT_MS=30000
# VM2API_DB_STATEMENT_TIMEOUT_MS=60000

# ==============================================================================
# 多级缓存配置（L1 进程内 LRU+Singleflight + 可选 L2 Redis + Pub/Sub 失效）
# ==============================================================================
REDIS_PASSWORD=
VM2API_REDIS_PORT=6379
# 若使用外部/云端 Redis，配置 REDIS_URL 即可；设为 1 可禁用 Redis（自动降级为 L1 + PG LISTEN/NOTIFY）
# REDIS_URL=redis://:password@redis.example.com:6379/0
# VM2API_REDIS_DISABLED=0
# VM2API_CACHE_L1_MAX_ITEMS=8192
# VM2API_APIKEY_CACHE_TTL_MS=60000
# VM2API_BILLING_CACHE_TTL_MS=300000
# VM2API_DASHBOARD_CACHE_TTL_MS=15000

# ==============================================================================
# 通用外部集成 API（/api/integration/v1，默认仅本机回环可访问）
# ==============================================================================
# 可在管理台通过 /api/panel/integration/* 动态创建与吊销细粒度权限令牌，也可通过下方环境变量引导：
# VM2API_INTEGRATION_ENABLED=1
# VM2API_INTEGRATION_ALLOW_REMOTE=0      # 0=仅允许 127.0.0.1/::1（推荐同机直连或 SSH 隧道）；1=允许远程接入
# VM2API_INTEGRATION_ALLOWED_IPS=        # allow_remote=1 时可选 IP 白名单（逗号分隔）
# VM2API_INTEGRATION_AUTH_HEADER=        # 可选自定义鉴权 Header 名（默认支持 Authorization Bearer / X-Integration-Token / X-API-Key）
# VM2API_INTEGRATION_TOKEN=              # 可选引导令牌（至少 24 字符，不与 VM2API_API_KEY 复用）
# VM2API_INTEGRATION_SCOPES=overview:read,vms:read,vms:write,proxies:read,proxies:write,credentials:write,endpoints:read,endpoints:write,keys:read,keys:write
