# copy to .env  (chmod 600). Used by docker compose and local node.
# VM2API_* wins; KIN_* is fallback.
#
# 未配置时一键脚本 / 容器入口会只填空字段：
#   管理台 admin / 123456（已有密码不覆盖）
#   VM2API_API_KEY / VM2API_DB_SECRET 为空则生成随机 hex

VM2API_API_KEY=
VM2API_ADMIN_USER=admin
VM2API_ADMIN_PASSWORD=123456
VM2API_DB_SECRET=

PORT=8787
HOST=0.0.0.0
# HOST 仅监听；/health、/v1/meta 的 base_url 需配置 PUBLIC_BASE_URL 或 PUBLIC_HOST（勿把 0.0.0.0 当对外地址）
# PUBLIC_BASE_URL=https://example.com
# PUBLIC_HOST=127.0.0.1
# GITHUB_TOKEN=          # 可选。面板查 GitHub Release 提高限额；也可用 VM2API_GITHUB_TOKEN

# PostgreSQL 17. The installer fills a random password for a new local database.
# External PG: set VM2API_DATABASE_URL and clear COMPOSE_PROFILES.
COMPOSE_PROFILES=postgres
VM2API_POSTGRES_PORT=55432
VM2API_POSTGRES_PASSWORD=
VM2API_DATABASE_URL=
# Preserve VM2API_DB_SECRET when importing an existing SQLite database.
